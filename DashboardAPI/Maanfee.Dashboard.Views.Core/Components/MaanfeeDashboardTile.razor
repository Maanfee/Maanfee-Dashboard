@namespace Maanfee.Dashboard.Views.Core
@using System.Timers

<MudCard Class="rounded-lg align-center">
    <MudCardContent>
        <MudText Color="Color" Typo="Typo.h6">@Title</MudText>
        <MudGrid>
            <MudItem md="6">
                <div class="d-flex align-center justify-center my-1 me-2 pa-4">
                    <MudIcon Color="@Color" Icon="@Icon" Size="Size.Medium" />
                    <MudText Typo="Typo.subtitle2">@InitialValue</MudText>
                </div>
            </MudItem>
            <MudItem md="6">
                <div class="d-flex align-end justify-end" style="height: 60px;">
                    @foreach (var bar in Bars)
                    {
                        <MudPaper Height="@($"{bar.Height}px")" Width="6px" Square Class="@chartClass" />
                    }
                </div>
            </MudItem>
        </MudGrid>
        <MudDivider DividerType="DividerType.FullWidth" />
        @if (!string.IsNullOrEmpty(Description))
        {
            <div class="pt-2">
                <MudText Align="Align.Start" Typo="Typo.caption">@Description</MudText>
            </div>
        }
    </MudCardContent>
</MudCard>

@code {
    private System.Timers.Timer? barTimer;
    private System.Timers.Timer? counterTimer;
    private Random random = new Random();
    private List<BarData> Bars = new();

    [Parameter]
    public string Title { get; set; } = "Title";

    [Parameter]
    public decimal Value { get; set; } = 0;

    [Parameter]
    public Color Color { get; set; }

    [Parameter]
    public string? ChartClass { get; set; }

    private string? chartClass;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Description { get; set; }

    private int BarCount { get; set; } = 10;

    private int MinBarHeight { get; set; } = 5;

    private int MaxBarHeight { get; set; } = 50;

    private decimal InitialValue = 0;

    [Parameter]
    public double UpdateIntervalSeconds { get; set; } = 1;

    [Parameter]
    public Color? BarColor { get; set; }

    protected override void OnInitialized()
    {
        InitializeBars();
        StartBarTimer();
    }

    protected override void OnParametersSet()
    {
        chartClass = $"{ChartClass} mr-1 rounded-t ";

        StartCounterTimer();
    }

    private void InitializeBars()
    {
        Bars.Clear();
        for (int i = 0; i < BarCount; i++)
        {
            Bars.Add(new BarData
            {
                Height = random.Next(MinBarHeight, MaxBarHeight + 1),
                Color = BarColor ?? GetRandomColor()
            });
        }
    }

    private void StartBarTimer()
    {
        barTimer = new System.Timers.Timer(UpdateIntervalSeconds * 1000);
        barTimer.Elapsed += OnBarTimerElapsed;
        barTimer.AutoReset = true;
        barTimer.Enabled = true;
    }

    private async void OnBarTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        UpdateBars();
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateBars()
    {
        foreach (var bar in Bars)
        {
            bar.Height = random.Next(MinBarHeight, MaxBarHeight + 1);
            if (BarColor == null)
            {
                bar.Color = GetRandomColor();
            }
        }
    }

    private Color GetRandomColor()
    {
        var colors = new[] { Color.Primary, Color.Secondary, Color.Success, Color.Warning, Color.Error, Color.Info };
        return colors[random.Next(colors.Length)];
    }

    public void Dispose()
    {
        barTimer?.Stop();
        barTimer?.Dispose();

        counterTimer?.Stop();
        counterTimer?.Dispose();
    }

    private class BarData
    {
        public int Height { get; set; }
        public Color Color { get; set; }
    }

    // ************************************

    private void StartCounterTimer()
    {
        InitialValue = 0;
        counterTimer = new System.Timers.Timer(10);
        counterTimer.Elapsed += OnCounterTimerElapsed;
        counterTimer.AutoReset = true;
        counterTimer.Enabled = true;
    }

    private async void OnCounterTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        if (Value > 0 && InitialValue < Value)
        {
            if (Value > 10000)
                InitialValue += 100;
            else if (Value > 5000)
                InitialValue += 50;
            else if (Value > 500)
                InitialValue += 40;
            else
                InitialValue += 2;
        }
        else if (Value < 0 && InitialValue > Value)
        {
            if (Value < 10000)
                InitialValue -= 100;
            else if (Value < 5000)
                InitialValue -= 50;
            else if (Value < 500)
                InitialValue -= 40;
            else
                InitialValue -= 2;
        }
        else
        {
            counterTimer?.Stop();
            InitialValue = Value;
        }
        await InvokeAsync(StateHasChanged);
    }

}
